---
// Confirmation link of the e-mail: /confirmer#t=<token> (token in the fragment only).
import PlaceView from '../components/PlaceView.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Confirmation — Daily Edge" noindex>
  <SiteHeader />
  <main id="contenu" class="container page">
    <p class="pending" role="status" data-confirm-pending>
      Confirmation de ton inscription…
    </p>
    <div class="failed" data-confirm-failed hidden>
      <h1 tabindex="-1">Ce lien ne fonctionne plus</h1>
      <p>
        Il a peut-être déjà servi, ou plus de 48 heures sont passées. Indique à nouveau ton e-mail :
        tu recevras un nouveau lien.
      </p>
      <p data-confirm-known hidden>
        <a href="/ma-place">Voir ma place</a>
      </p>
      <WaitlistForm idPrefix="relance" />
    </div>
    <PlaceView />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { track } from '../scripts/analytics';
  import { callFunction, type Place } from '../scripts/api';
  import { showPlace } from '../scripts/place';
  import { readStatusToken, takeFragment, writeStatusToken } from '../scripts/storage';

  const pending = document.querySelector<HTMLElement>('[data-confirm-pending]')!;
  const failed = document.querySelector<HTMLElement>('[data-confirm-failed]')!;

  function fail() {
    pending.hidden = true;
    failed.hidden = false;
    if (readStatusToken())
      failed.querySelector<HTMLElement>('[data-confirm-known]')!.hidden = false;
    failed.querySelector<HTMLElement>('h1')!.focus();
  }

  // A link pasted while already on this page only changes the fragment: start over
  window.addEventListener('hashchange', () => window.location.reload());

  const token = takeFragment('t');
  if (!token) {
    fail();
  } else {
    callFunction('waitlist-confirm', { token })
      .then(({ status, data }) => {
        if (status !== 200 || !data) return fail();
        writeStatusToken(String(data.status_token));
        track('waitlist_confirmed');
        pending.hidden = true;
        showPlace(data as unknown as Place);
      })
      .catch(fail);
  }
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .failed {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .failed[hidden],
  .pending[hidden] {
    display: none;
  }
</style>
