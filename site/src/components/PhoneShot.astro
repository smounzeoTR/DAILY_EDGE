---
// App screenshot in a phone frame (captures: app/e2e/site-screenshots.yaml). AVIF and WebP at two
// widths, WebP fallback (never the original PNG), width and height set (no layout shift); only the
// hero loads eagerly.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  size?: 'sm' | 'md' | 'lg';
  priority?: boolean;
}

const { image, alt, size = 'md', priority = false } = Astro.props;
const width = { sm: 256, md: 288, lg: 320 }[size];
---

<div class:list={['phone', size]}>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={70}
    width={width * 2}
    widths={[width, width * 2]}
    sizes={`${width}px`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</div>

<style>
  .phone {
    width: 100%;
    margin-inline: auto;
    padding: 8px;
    border-radius: 44px;
    background: #0b1b3f;
    /* Keeps the frame visible on the dark theme background */
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 40px rgb(11 27 63 / 0.18);
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 36px;
  }

  .sm {
    max-width: 16rem;
  }

  .md {
    max-width: 18rem;
  }

  .lg {
    max-width: 20rem;
  }
</style>
