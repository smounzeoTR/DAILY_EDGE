---
// Reserved slot for a visual supplied later (fixed ratio: no layout shift when the image arrives).
// Shapes and sizes are classes (no inline style: strict CSP).
interface Props {
  label: string;
  /** phone: App Store capture (1290 × 2796); wide: 16 / 10 */
  shape: 'phone' | 'wide';
  size?: 'sm' | 'md' | 'lg' | 'full';
}

const { label, shape, size = 'full' } = Astro.props;
---

<div class:list={['placeholder', shape, size]} role="img" aria-label={label}>
  <span aria-hidden="true">{label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    margin-inline: auto;
    padding: var(--space-4);
    border: 2px dashed var(--color-field-border);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .phone {
    aspect-ratio: 1290 / 2796;
  }

  .wide {
    aspect-ratio: 16 / 10;
  }

  .sm {
    max-width: 16rem;
  }

  .md {
    max-width: 18rem;
  }

  .lg {
    max-width: 20rem;
  }

  .full {
    max-width: 100%;
  }
</style>
