---
import Card from '../Card.astro';
import principle from '../../assets/screens/1-principle.png';
import checkin from '../../assets/screens/2-checkin.png';
import habits from '../../assets/screens/3-habits.png';
import PhoneShot from '../PhoneShot.astro';
import Section from '../Section.astro';

const steps = [
  {
    title: 'Un principe par jour',
    text: 'Tiré de Hill, Kiyosaki, Clear, Covey et des autres grands livres de réussite, expliqué en quelques lignes, avec ce qu’il change pour toi aujourd’hui.',
    image: principle,
    alt: 'L’exercice du jour avec les boutons Fait, Pas le temps et Trop dur, suivi de « Pourquoi aujourd’hui ».',
  },
  {
    title: 'Un plan qui s’ajuste',
    text: 'Chaque soir, un check-in rapide : ton énergie, ton temps disponible demain. Le plan du lendemain s’adapte, jusqu’à une version courte les jours chargés.',
    image: checkin,
    alt: 'Le check-in du soir : énergie, humeur et temps disponible demain.',
  },
  {
    title: 'Des habitudes minuscules',
    text: 'Trois habitudes assez petites pour tenir même quand la journée déborde. Un jour manqué ne casse pas ta série : tu reprends simplement le lendemain.',
    image: habits,
    alt: 'Trois habitudes, chacune avec son signal et sa version minimale.',
  },
];
---

<Section
  id="comment-ca-marche"
  eyebrow="Comment ça marche"
  title="10 minutes par jour, pas une de plus"
  intro="Pas un résumé de plus à lire : chaque jour, quelque chose à faire."
>
  <ol class="steps">
    {steps.map((step, index) => (
      <Card as="li">
        <span class:list={['step', index === 2 && 'step-accent']} aria-hidden="true">
          {index + 1}
        </span>
        <h3>{step.title}</h3>
        <p class="text">{step.text}</p>
        <PhoneShot image={step.image} alt={step.alt} size="sm" />
      </Card>
    ))}
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-chip);
    background: var(--color-button-bg);
    color: var(--color-button-text);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  /* Orange marks momentum (identity: step 3); ink text keeps AA contrast */
  .step-accent {
    background: var(--color-accent);
    color: var(--color-ink-on-accent);
  }

  .text {
    color: var(--color-text-muted);
  }
</style>
