---
// The one-page site (§ 4), shared by / and the source landing pages.
import { pricing } from '../config';
import type { LandingSource } from '../data/sources';
import BaseLayout from '../layouts/BaseLayout.astro';
import Coach from './sections/Coach.astro';
import Faq from './sections/Faq.astro';
import FinalCta from './sections/FinalCta.astro';
import Hero from './sections/Hero.astro';
import HowItWorks from './sections/HowItWorks.astro';
import Pricing from './sections/Pricing.astro';
import Proof from './sections/Proof.astro';
import Trust from './sections/Trust.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  source?: LandingSource | undefined;
}

const { source } = Astro.props;

// SoftwareApplication (§ 9): prices only, never a rating until real reviews exist
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Daily Edge',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'iOS, Android',
  inLanguage: 'fr',
  url: new URL('/', Astro.site).href,
  image: new URL('/og.png', Astro.site).href,
  description:
    'Un principe tiré des grands livres de réussite, un exercice concret et trois habitudes. 10 minutes par jour, ajustées chaque soir.',
  offers: [
    { '@type': 'Offer', name: 'Gratuit', price: '0', priceCurrency: 'EUR' },
    {
      '@type': 'Offer',
      name: 'Premium annuel',
      price: pricing.yearly.replace(/[^\d,]/g, '').replace(',', '.'),
      priceCurrency: 'EUR',
    },
    {
      '@type': 'Offer',
      name: 'Premium mensuel',
      price: pricing.monthly.replace(/[^\d,]/g, '').replace(',', '.'),
      priceCurrency: 'EUR',
    },
  ],
};
---

<BaseLayout canonical={source ? '/' : undefined} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="contenu">
    <Hero source={source} />
    <HowItWorks />
    <Proof />
    <Coach />
    <Pricing />
    <Trust />
    <Faq />
    <FinalCta source={source} />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { track } from '../scripts/analytics';

  const params = new URLSearchParams(window.location.search);
  track('landing_view', {
    landing_path: window.location.pathname,
    utm_source: params.get('utm_source') ?? undefined,
    utm_medium: params.get('utm_medium') ?? undefined,
    utm_campaign: params.get('utm_campaign') ?? undefined,
  });
</script>
