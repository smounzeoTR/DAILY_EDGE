---
// ALTCHA proof-of-work (anti-robot), invisible: computed in the background as soon as the visitor
// enters the form (or at submit), sent
// with the form in the hidden field "altcha". Challenges come from our altcha-challenge function.
import { PUBLIC_FUNCTIONS_URL } from 'astro:env/client';

const challenge = `${PUBLIC_FUNCTIONS_URL.replace(/\/+$/, '')}/altcha-challenge`;
---

<altcha-widget
  challenge={challenge}
  name="altcha"
  display="invisible"
  auto="onfocus"
  language="fr"
  configuration={JSON.stringify({
    humanInteractionSignature: false,
    hideFooter: true,
    hideLogo: true,
  })}
  data-altcha
></altcha-widget>

<script>
  // External build (strict CSP): no bundled blob: worker, no injected style; the PBKDF2 worker
  // is served as a file of the site
  import 'altcha/external';
  import 'altcha/altcha.css';
  import Pbkdf2Worker from 'altcha/workers/pbkdf2?worker';

  const registry = (
    globalThis as unknown as {
      $altcha?: { algorithms: { set: (name: string, create: () => Worker) => void } };
    }
  ).$altcha;
  registry?.algorithms.set('PBKDF2/SHA-256', () => new Pbkdf2Worker());
</script>
