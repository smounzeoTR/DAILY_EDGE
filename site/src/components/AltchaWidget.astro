---
// ALTCHA proof-of-work (anti-robot), invisible: loaded and computed in the background as soon as
// the visitor enters the form (or at submit), sent
// with the form in the hidden field "altcha". Challenges come from our altcha-challenge function.
import { PUBLIC_FUNCTIONS_URL } from 'astro:env/client';

const challenge = `${PUBLIC_FUNCTIONS_URL.replace(/\/+$/, '')}/altcha-challenge`;
---

<altcha-widget
  challenge={challenge}
  name="altcha"
  display="invisible"
  auto="off"
  language="fr"
  configuration={JSON.stringify({
    humanInteractionSignature: false,
    hideFooter: true,
    hideLogo: true,
  })}
  data-altcha
></altcha-widget>

<script>
  import { loadAltcha } from '../scripts/altchaLoader';

  // As soon as the visitor enters a form with a widget: load ALTCHA and start the proof-of-work
  document.addEventListener('focusin', (event) => {
    const form = (event.target as Element | null)?.closest('form');
    const widget = form?.querySelector<HTMLElement & { verify?: () => void }>('altcha-widget');
    if (!widget || widget.dataset.started) return;
    widget.dataset.started = 'true';
    void loadAltcha().then(() => widget.verify?.());
  });
</script>
