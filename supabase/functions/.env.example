# AI settings of the Edge Functions (premium personalization). Never commit real keys.
# Production: supabase secrets set LLM_PROVIDER=... LLM_MODEL=... ANTHROPIC_API_KEY=... (etc.)
# Local stack: the mock provider is configured in supabase/config.toml [edge_runtime.secrets].
# Real provider test from the Mac (optional, costs a few tokens): copy this file to .env.llm at the
# repository root (ignored by git), fill in a key, then `npm run llm:smoke` / `npm run assistant:eval`.
# Never name it supabase/functions/.env: the local Edge runtime would load it and the app and the
# integration tests would call the real (paid) provider instead of the mock.

# anthropic | mistral | mock | none (none or a missing value = rules only)
LLM_PROVIDER=anthropic

# Small, economical model (target: < 0.30 EUR per active user per month)
LLM_MODEL=claude-haiku-5-5
# Thinking effort for Anthropic models: low (default), medium or high
LLM_ANTHROPIC_EFFORT=low

# Cost estimate per million tokens. Prices checked on 23 November 2026 on the official list
# https://platform.claude.com/docs/en/about-claude/pricing (USD; reported as is, which slightly
# overestimates the cost in EUR): claude-haiku-5-5 0.10 input, 0.50 output, 0.125 cache write
# (5 min), 0.01 cache read; prompts over 100,000 tokens cost 5x (never reached by the plan).
LLM_PRICE_IN_EUR_PER_MTOK=0.10
LLM_PRICE_OUT_EUR_PER_MTOK=0.50
LLM_PRICE_CACHE_READ_EUR_PER_MTOK=0.01
LLM_PRICE_CACHE_WRITE_EUR_PER_MTOK=0.125

ANTHROPIC_API_KEY=

# Alternative: LLM_PROVIDER=mistral, LLM_MODEL=mistral-small-latest and its prices
MISTRAL_API_KEY=

# Coach Edge assistant (lot 9): its own provider, model and prices (keys above are shared).
# Locally the mock is set in config.toml; .env.llm is used by npm run assistant:eval only.
# Decision of 22 November 2026, to confirm with the real cost: Sonnet for the assistant
# (Haiku stays for the plan and the review above). Official list, checked on 23 November 2026:
# claude-sonnet-5-5 2 USD input, 10 USD output, 2.50 cache write (5 min), 0.10 cache read
# (0.05x the input price for this model, not the usual 0.1x: set explicitly below).
LLM_ASSISTANT_PROVIDER=anthropic
LLM_ASSISTANT_MODEL=claude-sonnet-5-5
LLM_ASSISTANT_EFFORT=low
LLM_ASSISTANT_PRICE_IN_EUR_PER_MTOK=2.00
LLM_ASSISTANT_PRICE_OUT_EUR_PER_MTOK=10.00
# Prompt caching (fixed prompt and tool definitions): checked prices, see above.
LLM_ASSISTANT_PRICE_CACHE_READ_EUR_PER_MTOK=0.10
LLM_ASSISTANT_PRICE_CACHE_WRITE_EUR_PER_MTOK=2.50

# dailyedge.fr waitlist (site lot S2): transactional e-mails via Scaleway TEM, sender
# bonjour@auth.dailyedge.fr. Production: supabase secrets set (values never committed).
# Locally config.toml sends to Mailpit (MAILER_PROVIDER=mailpit).
# scaleway | mailpit | log (log: written to the function log, nothing sent)
MAILER_PROVIDER=scaleway
SCW_SECRET_KEY=
SCW_PROJECT_ID=
# Scaleway TEM region, e.g. fr-par
SCW_TEM_REGION=
# Public site URL (links in e-mails, allowed CORS origin), e.g. https://dailyedge.fr
SITE_URL=

# dailyedge.fr web diagnostic (site lot S3a): store links of the result e-mail (https), the
# buttons are hidden while empty. Production: supabase secrets set (sent by `deploy secrets`).
APP_STORE_URL=
PLAY_STORE_URL=

# dailyedge.fr anti-abuse (site lot S4): key signing the ALTCHA challenges (openssl rand -hex 32).
# Optional difficulty: ALTCHA_COST (PBKDF2 iterations, default 5000), ALTCHA_COUNTER_MIN/MAX
# (default 5000/10000). CLIENT_IP_SOURCE is for the local stack only (xff-rightmost).
ALTCHA_HMAC_KEY=
