# AI settings of the Edge Functions (premium personalization). Never commit real keys.
# Production: supabase secrets set LLM_PROVIDER=... LLM_MODEL=... ANTHROPIC_API_KEY=... (etc.)
# Local stack: the mock provider is configured in supabase/config.toml [edge_runtime.secrets].
# Real provider test from the Mac (optional, costs a few tokens): copy this file to .env.llm at the
# repository root (ignored by git), fill in a key, then `npm run llm:smoke` / `npm run assistant:eval`.
# Never name it supabase/functions/.env: the local Edge runtime would load it and the app and the
# integration tests would call the real (paid) provider instead of the mock.

# anthropic | mistral | mock | none (none or a missing value = rules only)
LLM_PROVIDER=anthropic

# Small, economical model (target: < 0.30 EUR per active user per month)
LLM_MODEL=claude-haiku-5-5
# Thinking effort for Anthropic models: low (default), medium or high
LLM_ANTHROPIC_EFFORT=low

# Cost estimate in EUR per million tokens.
# To check against the official price list before production (lot 10):
# claude-haiku-5-5 was listed at 0.10 USD (input) and 0.50 USD (output) per million tokens.
LLM_PRICE_IN_EUR_PER_MTOK=0.10
LLM_PRICE_OUT_EUR_PER_MTOK=0.50

ANTHROPIC_API_KEY=

# Alternative: LLM_PROVIDER=mistral, LLM_MODEL=mistral-small-latest and its prices
MISTRAL_API_KEY=

# Coach Edge assistant (lot 9): its own provider, model and prices (keys above are shared).
# Locally the mock is set in config.toml; .env.llm is used by npm run assistant:eval only.
# Decision of 22 November 2026, to confirm with the real cost: Sonnet for the assistant
# (Haiku stays for the plan and the review above). Prices to check on the official list (lot 10):
# claude-sonnet-5-5 was listed at 2 USD (input) and 10 USD (output) per million tokens.
LLM_ASSISTANT_PROVIDER=anthropic
LLM_ASSISTANT_MODEL=claude-sonnet-5-5
LLM_ASSISTANT_EFFORT=low
LLM_ASSISTANT_PRICE_IN_EUR_PER_MTOK=2.00
LLM_ASSISTANT_PRICE_OUT_EUR_PER_MTOK=10.00
# Prompt caching (fixed prompt and tool definitions): reads and writes, to check in lot 10.
# claude-sonnet-5-5 was listed at 0.10 USD (cache read) and 2.50 USD (5-minute cache write).
LLM_ASSISTANT_PRICE_CACHE_READ_EUR_PER_MTOK=0.10
LLM_ASSISTANT_PRICE_CACHE_WRITE_EUR_PER_MTOK=2.50
