{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vitest.config.ts",
    "supabase/functions/_shared/**/*.ts",
    "scripts/**/*.ts",
    "vitest.integration.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "supabase/functions/generate-plan"
  ]
}
