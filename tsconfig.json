{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    // Type imports of the app onboarding copy (parity test of the shared program rule)
    "paths": {
      "@/*": ["./app/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "supabase/functions/_shared/**/*.ts",
    "scripts/**/*.ts",
    "vitest.integration.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "supabase/functions/generate-plan",
    "supabase/functions/generate-plans-batch",
    "supabase/functions/_shared/plans",
    "supabase/functions/generate-review",
    "supabase/functions/export-my-data",
    "supabase/functions/assistant-chat",
    "supabase/functions/waitlist-join",
    "supabase/functions/waitlist-confirm",
    "supabase/functions/waitlist-status",
    "supabase/functions/diagnostic-submit",
    "supabase/functions/diagnostic-confirm-marketing",
    "supabase/functions/altcha-challenge"
  ]
}
