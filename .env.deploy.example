# Deployment values for one Supabase project. Copy to .env.recette or .env.production at the
# repository root (ignored by git) and fill in. Read by `npm run deploy` and the catalogue import.
# Never commit the filled copies; never put these values in the app.

# ---- Project (Supabase dashboard: Project Settings) ----
# Reference: the subdomain of the project URL (https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<ref>.supabase.co
# Session pooler connection string (IPv4), Project Settings > Database > Connect
SUPABASE_DB_URL=postgresql://postgres.<ref>:<database password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Personal access token (Account > Access tokens), used by the CLI and the Management API
SUPABASE_ACCESS_TOKEN=

# ---- Auth (sign-in e-mails through Scaleway Transactional Email) ----
AUTH_SITE_URL=https://dailyedge.trasenel.com
SMTP_HOST=smtp.tem.scw.cloud
SMTP_PORT=587
# Scaleway console > Transactional Email > SMTP credentials (check the user/password shown there)
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=connexion@dailyedge.trasenel.com
SMTP_SENDER_NAME=Daily Edge

# ---- Edge Function secrets (only these keys are sent by `deploy secrets`) ----
# openssl rand -hex 32 (also written to Vault by `deploy vault`)
PLANS_BATCH_SECRET=

# AI: Haiku for the plan and the review, Sonnet for Coach Edge (decision of 22 November 2026).
# Prices checked on 23 November 2026 (supabase/functions/.env.example).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_ANTHROPIC_EFFORT=low
LLM_PRICE_IN_EUR_PER_MTOK=0.10
LLM_PRICE_OUT_EUR_PER_MTOK=0.50
LLM_PRICE_CACHE_READ_EUR_PER_MTOK=0.01
LLM_PRICE_CACHE_WRITE_EUR_PER_MTOK=0.125
LLM_ASSISTANT_PROVIDER=anthropic
LLM_ASSISTANT_MODEL=claude-sonnet-5-5
LLM_ASSISTANT_EFFORT=low
LLM_ASSISTANT_PRICE_IN_EUR_PER_MTOK=2.00
LLM_ASSISTANT_PRICE_OUT_EUR_PER_MTOK=10.00
LLM_ASSISTANT_PRICE_CACHE_READ_EUR_PER_MTOK=0.10
LLM_ASSISTANT_PRICE_CACHE_WRITE_EUR_PER_MTOK=2.50
# One key per environment (separate Anthropic workspaces, each with its own spend limit)
ANTHROPIC_API_KEY=

# Operations alerts by e-mail (Scaleway Transactional Email API)
OPS_ALERT_EMAIL_PROVIDER=scaleway
# recette or production (shown in the alert subject; must match the file)
OPS_ENV_NAME=recette
OPS_ALERT_FROM=alertes@dailyedge.trasenel.com
OPS_ALERT_TO=
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_REGION=fr-par
