# Copy to app/.env and fill with values from `supabase status` (local) or the Supabase project.
# Only public values here: never put the secret / service_role key in the app.
# Simulator: http://127.0.0.1:54321 ; phone: http://<Mac LAN IP>:54321 (ipconfig getifaddr en0)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from `supabase status` (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional (lot 10a). Empty = off (local, tests).
# Sentry DSN of the EU project (no personal data is sent, see src/lib/scrub.ts)
EXPO_PUBLIC_SENTRY_DSN=
# Local builds without Sentry upload of source maps
SENTRY_DISABLE_AUTO_UPLOAD=true
# PostHog EU project key; events only with the user's "Mesure d'audience" consent
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Legal pages, served by the site; default https://dailyedge.fr (recette: https://recette.dailyedge.fr)
EXPO_PUBLIC_LEGAL_BASE_URL=https://dailyedge.fr
# development (local) | recette | production: set by the EAS profile (eas.json)
EXPO_PUBLIC_APP_ENV=development
